#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
# pylint: disable=invalid-name
"""
kernel-sloc - Count source lines of code for a configured kernel build.

Adapted from the Unikraft build-time SLOC reporting approach
(https://github.com/orgs/unikraft/discussions/1849#discussioncomment-19352529),
which counts compiled sources rather than the whole source tree.

The kernel mode counts whole compiled files, including inactive #if branches,
but not the headers they include. The dwarf mode estimates source lines
represented by debug information in a linked ELF; it does not measure runtime
coverage. Neither count is a certification or structural-coverage result.
"""

import csv
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile


def die(message):
    """Print an error message to stderr and terminate with exit code 1."""
    sys.stderr.write(f"ERROR: {message}\n")
    sys.exit(1)


def need_command(cmd):
    """Ensure the specified executable command is available in PATH."""
    if not shutil.which(cmd):
        die(f"required command not found: {cmd}")


def need_cloc():
    """Ensure cloc command is available in PATH."""
    if not shutil.which("cloc"):
        die(
            "required command not found: cloc "
            "(install cloc to use kernel, tree, or files mode)"
        )


def usage(prog, stream=sys.stdout):
    """Print command usage and examples to the given output stream."""
    lines = [
        f"Usage: {prog} [--report JSON_FILE] MODE TARGET...\n",
        "  kernel BUILD_DIR  Count whole compiled sources from "
        "compile_commands.json.\n",
        "                    Requires cloc and python3. Generate the "
        "database after\n",
        "                    a clean build of the configuration being "
        "measured.\n",
        "  dwarf ELF         Estimate distinct source lines using DWARF "
        "addresses.\n",
        "                    Requires GNU objdump, addr2line, and python3, "
        "plus\n",
        "                    an ELF built with debug information "
        "(CONFIG_DEBUG_INFO).\n",
        "                    Set OBJDUMP and ADDR2LINE for cross builds, "
        "or set\n",
        "                    CROSS_COMPILE to the toolchain prefix.\n",
        "  tree DIR          Count all C, C++, and header sources; "
        "requires cloc.\n",
        "  files FILE...     Count individual source files; "
        "requires cloc.\n",
        "  --report FILE     JSON inventory for kernel or dwarf; "
        "parent must exist.\n",
        "                    Lists compiled files, or DWARF source_lines "
        "and functions.\n",
        "                    Does not measure execution or list every "
        "linked symbol.\n",
        "  -h, --help        Show this help and exit successfully.\n",
        "\n",
        "Success prints one integer on stdout and a summary on stderr.\n",
        "Errors exit non-zero without printing a count.\n",
        "Counts depend on the tool versions and build options; record both.\n",
        "\n",
        "Examples:\n",
        f"  {prog} --report compiled.json kernel .\n",
        f"  {prog} --report linked.json dwarf vmlinux\n",
        f"  {prog} files foo.c\n",
        f"  {prog} tree /path/to/files\n",
        "files omits linked libc; tree includes unused C/C++/headers, not "
        "other\n",
        "languages. Neither is a deployed-footprint total.\n",
    ]
    stream.write("".join(lines))
    stream.flush()


def cloc_sum(csv_content):
    """Extract the total code line count from cloc CSV output."""
    total = 0
    reader = csv.reader(csv_content.splitlines())
    for row in reader:
        if len(row) >= 5 and row[1] == "SUM":
            try:
                total = int(row[4])
            except ValueError:
                total = 0
    return total


def cloc_sum_from_list(list_path):
    """Execute cloc on a source-list file and return code total."""
    try:
        proc = subprocess.run(
            [
                "cloc",
                f"--list-file={list_path}",
                "--skip-uniqueness",
                "--csv",
                "--quiet",
            ],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError:
        die("cloc failed while counting source files")
    return cloc_sum(proc.stdout)


def _check_report_overwrite(path, target, mode, files):
    """Ensure report path does not overwrite measured inputs."""
    protected = [target] + files
    if mode == "kernel":
        protected.append(os.path.join(target, "compile_commands.json"))

    try:
        real_path = os.path.realpath(path)
        if real_path in {os.path.realpath(p) for p in protected if p}:
            die("report must not overwrite a measured input")
        if os.path.exists(path) and any(
            os.path.exists(p) and os.path.samefile(path, p)
            for p in protected
            if p
        ):
            die("report must not overwrite a measured input")
    except OSError:
        pass


def write_report(path, mode, target, count, data):
    """Atomically write the inventory JSON report."""
    data = dict(data)
    data.update(mode=mode, target=os.path.abspath(target), sloc=int(count))
    _check_report_overwrite(path, target, mode, data.get("files", []))

    parent_dir = os.path.dirname(os.path.abspath(path))
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=parent_dir,
            delete=False,
        ) as output:
            temporary = output.name
            json.dump(data, output, indent=2, sort_keys=True)
            output.write("\n")
        os.replace(temporary, path)
    except OSError as error:
        die(f"cannot write report {path}: {error}")
    finally:
        if temporary and os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                pass


def mode_files(sources):
    """Count source lines for an explicit list of source files."""
    need_cloc()
    for source in sources:
        if not os.path.isfile(source):
            die(f"source file not found: {source}")
        if "\n" in source or "\r" in source:
            die("source paths must not contain newlines")

    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", delete=False
    ) as tf:
        for s in sources:
            tf.write(f"{s}\n")
        list_path = tf.name

    try:
        n = cloc_sum_from_list(list_path)
    finally:
        if os.path.exists(list_path):
            os.unlink(list_path)

    sys.stderr.write(f"files: {len(sources)} path(s), {n} SLOC\n")
    sys.stderr.flush()
    print(n)


def mode_tree(target_dir):
    """Count source lines in all C, C++, and header files within target_dir."""
    need_cloc()
    if not os.path.isdir(target_dir):
        die(f"source dir not found: {target_dir}")

    try:
        proc = subprocess.run(
            [
                "cloc",
                "--include-lang=C,C++,C/C++ Header",
                "--skip-uniqueness",
                "--csv",
                "--quiet",
                target_dir,
            ],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError:
        die("cloc failed while counting source tree")

    n = cloc_sum(proc.stdout)
    sys.stderr.write(
        f"source tree {target_dir} (C/C++ and headers): {n} SLOC\n"
    )
    sys.stderr.flush()
    print(n)


def _ensure_compile_commands(target_dir):
    """Ensure compile_commands.json exists or generate it via clang-tools."""
    ccj = os.path.join(target_dir, "compile_commands.json")
    if os.path.isfile(ccj):
        return ccj

    script_dir = os.path.dirname(os.path.realpath(__file__))
    gen = os.path.join(script_dir, "clang-tools", "gen_compile_commands.py")
    if not os.path.isfile(gen):
        die("no compile_commands.json or generator (build the kernel first)")

    sys.stderr.write("generating compile_commands.json ...\n")
    sys.stderr.flush()
    try:
        subprocess.run(
            [sys.executable, gen, "-d", target_dir, "-o", ccj],
            check=True,
        )
    except subprocess.CalledProcessError:
        die("gen_compile_commands.py failed")
    return ccj


def _parse_compiled_sources(ccj_path):
    """Extract and deduplicate source files from compile_commands.json."""
    try:
        with open(ccj_path, encoding="utf-8") as f:
            commands = json.load(f)
    except (OSError, json.JSONDecodeError) as err:
        die(f"cannot read {ccj_path}: {err}")

    base = os.path.dirname(os.path.abspath(ccj_path))
    seen = []
    seen_set = set()
    for entry in commands:
        source = entry.get("file")
        if not source:
            continue
        directory = os.path.join(base, entry.get("directory", ""))
        path = os.path.realpath(os.path.join(directory, source))
        if not os.path.isfile(path):
            die(f"compiled source not found: {path}")
        if "\n" in path or "\r" in path:
            die("source paths must not contain newlines")
        if path not in seen_set:
            seen_set.add(path)
            seen.append(path)

    if not seen:
        die("no compiled sources found (build the kernel first)")
    return seen


def mode_kernel(report, target_dir):
    """Count compiled source lines for a configured kernel build."""
    need_cloc()
    need_command("python3")
    if not os.path.isdir(target_dir):
        die(f"kernel build dir not found: {target_dir}")

    ccj = _ensure_compile_commands(target_dir)
    seen = _parse_compiled_sources(ccj)

    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", delete=False
    ) as tf:
        for s in seen:
            tf.write(f"{s}\n")
        list_path = tf.name

    try:
        n = cloc_sum_from_list(list_path)
    finally:
        if os.path.exists(list_path):
            os.unlink(list_path)

    if report:
        write_report(
            report,
            "kernel",
            target_dir,
            n,
            {"files": sorted(seen)},
        )

    sys.stderr.write(
        f"kernel compiled sources: {len(seen)} files, {n} SLOC\n"
    )
    sys.stderr.flush()
    print(n)


def _resolve_toolchain():
    """Resolve objdump and addr2line binaries with cross prefix support."""
    objdump = os.environ.get("OBJDUMP")
    cross_compile = os.environ.get("CROSS_COMPILE", "")
    if not objdump:
        objdump = f"{cross_compile}objdump"

    addr2line = os.environ.get("ADDR2LINE")
    if not addr2line:
        if objdump.endswith("objdump"):
            addr2line = f"{objdump[:-7]}addr2line"
        else:
            addr2line = f"{cross_compile}addr2line"

    need_command(objdump)
    need_command(addr2line)
    need_command("python3")
    return objdump, addr2line


def _extract_line_addresses(objdump, elf_target, env):
    """Run objdump --dwarf=decodedline and collect sorted unique addresses."""
    try:
        proc = subprocess.run(
            [objdump, "--dwarf=decodedline", elf_target],
            capture_output=True,
            text=True,
            check=True,
            env=env,
        )
    except subprocess.CalledProcessError as err:
        die(f"objdump failed: {err}")

    addresses = set()
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1].isdigit():
            addresses.add(parts[2])

    return sorted(addresses)


def _run_addr2line(addr2line, elf_target, sorted_addresses, with_func, env):
    """Feed addresses to addr2line and return output."""
    if not sorted_addresses:
        return ""
    cmd = [addr2line]
    if with_func:
        cmd.append("-f")
    cmd.extend(["-e", elf_target])
    try:
        proc = subprocess.run(
            cmd,
            input="\n".join(sorted_addresses) + "\n",
            capture_output=True,
            text=True,
            check=True,
            env=env,
        )
        return proc.stdout
    except subprocess.CalledProcessError as err:
        die(f"addr2line failed: {err}")
    return ""


def _parse_dwarf_locations(locations_output, with_func):
    """Parse addr2line output into unique source lines and functions."""
    seen = set()
    functions = set()
    rows = iter(locations_output.splitlines())
    for row in rows:
        function = None
        if with_func:
            function = row.strip()
            row = next(rows, None)
            if row is None:
                die("incomplete addr2line function/location pair")
        match = re.fullmatch(
            r"(.*):([0-9]+)(?: \(discriminator [0-9]+\))?", row.strip()
        )
        if match and match.group(1) != "??" and int(match.group(2)) > 0:
            file_path = os.path.normpath(match.group(1))
            line_no = int(match.group(2))
            seen.add((file_path, line_no))
            if function and function != "??":
                functions.add((function, file_path))
    return seen, functions


def mode_dwarf(report, elf_target):
    """Estimate source lines from DWARF debug info in a linked ELF binary."""
    if not os.path.isfile(elf_target):
        die(f"ELF not found: {elf_target} (build with debug information)")

    objdump, addr2line = _resolve_toolchain()
    env = os.environ.copy()
    env["LC_ALL"] = "C"

    sorted_addresses = _extract_line_addresses(objdump, elf_target, env)
    locations_output = _run_addr2line(
        addr2line, elf_target, sorted_addresses, bool(report), env
    )
    seen, functions = _parse_dwarf_locations(locations_output, bool(report))

    n = len(seen)
    if n == 0:
        die("no DWARF source lines found (build with CONFIG_DEBUG_INFO)")

    if report:
        inventory = {
            "files": sorted({f for f, _ in seen}),
            "source_lines": [
                {"file": f, "line": l} for f, l in sorted(seen)
            ],
            "functions": [
                {"name": name, "file": f} for name, f in sorted(functions)
            ],
        }
        write_report(report, "dwarf", elf_target, n, inventory)

    sys.stderr.write(
        f"dwarf distinct source lines (debug-info estimate): {n}\n"
    )
    sys.stderr.flush()
    print(n)


def _parse_cli(prog, argv):
    """Validate and parse command-line arguments."""
    args = list(argv)
    report = None

    if args and args[0] == "--report":
        if len(args) < 4 or not args[1] or args[1].startswith("-"):
            usage(prog, sys.stderr)
            sys.exit(2)
        report = args[1]
        args = args[2:]

    if not args:
        usage(prog, sys.stderr)
        sys.exit(2)

    cmd = args[0]
    if cmd in ("-h", "--help"):
        if len(args) == 1 and report is None:
            usage(prog, sys.stdout)
            sys.exit(0)
        usage(prog, sys.stderr)
        sys.exit(2)

    if cmd in ("kernel", "dwarf", "tree"):
        if len(args) != 2:
            usage(prog, sys.stderr)
            sys.exit(2)
        mode = cmd
        target = args[1]
    elif cmd == "files":
        if len(args) < 2:
            usage(prog, sys.stderr)
            sys.exit(2)
        mode = cmd
        target = args[1:]
    else:
        usage(prog, sys.stderr)
        sys.exit(2)

    if report is not None and mode not in ("kernel", "dwarf"):
        die("--report supports only kernel and dwarf modes")

    return report, mode, target


def main(argv=None):
    """Main program entry point."""
    if argv is None:
        argv = sys.argv[1:]
    prog = sys.argv[0]

    report, mode, target = _parse_cli(prog, argv)

    if mode == "files":
        mode_files(target)
    elif mode == "tree":
        mode_tree(target)
    elif mode == "kernel":
        mode_kernel(report, target)
    elif mode == "dwarf":
        mode_dwarf(report, target)


if __name__ == "__main__":
    main()
